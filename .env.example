APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=postgresql+psycopg://icc_erp:local-development-only@db:5432/icc_erp
DEMONSTRATOR=true
SEED_DEMO_DATA=false
DRIVE_VALIDATION_MODE=mock
RATELIMIT_STORAGE_URI=memory://

