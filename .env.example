APP_ENV=development
# Leave blank for a persisted local development key. Set explicitly outside local development.
SECRET_KEY=
# Leave unset for local SQLite. Docker Compose supplies its PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg://icc_erp:local-development-only@db:5432/icc_erp
DEMONSTRATOR=true
SEED_DEMO_DATA=false
DRIVE_VALIDATION_MODE=mock
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
INTERNAL_JOB_AUDIENCE=
SCHEDULER_SERVICE_ACCOUNT=
TASKS_SERVICE_ACCOUNT=
GCP_PROJECT_ID=
GCP_REGION=asia-south1
CLOUD_TASKS_QUEUE=
INTERNAL_JOB_BASE_URL=
NOTIFICATION_EMAIL_MODE=disabled
BREACHED_PASSWORD_CHECK_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
OPERATIONAL_RETENTION_DAYS=2555
AUDIT_RETENTION_DAYS=2555
REJECTED_APPLICATION_RETENTION_DAYS=365
OFFLINE_SNAPSHOT_TTL_SECONDS=28800
RATELIMIT_STORAGE_URI=memory://

# Used only for the explicit `flask bootstrap-admin` command.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
